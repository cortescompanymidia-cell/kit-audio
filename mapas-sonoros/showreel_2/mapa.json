    "texto": "turning raw footage into a clear story."
   },
   {
    "inicio": 8.27,
    "fim": 12.74,
    "texto": "Keeping the rhythm. No boring moments. No wasted seconds."
   },
   {
    "inicio": 13.55,
    "fim": 14.73,
    "texto": "Smart use of AI."
   },
   {
    "inicio": 15.34,
    "fim": 20.04,
    "texto": "not to replace creativity, but to enhance speed, precision, and possibilities."
   },
   {
    "inicio": 21.1,
    "fim": 23.94,
    "texto": "Seamless transitions. Clean color grading."
   },
   {
    "inicio": 24.68,
    "fim": 25.57,
    "texto": "Stabilization."
   },
   {
    "inicio": 26.25,
    "fim": 29.64,
    "texto": "Motion graphics that serve the story, not distract from it."
   },
   {
    "inicio": 30.86,
    "fim": 34.12,
    "texto": "And most importantly, knowing when to slow down."
   },
   {
    "inicio": 34.92,
    "fim": 37.38,
    "texto": "and when to let the moment speak for itself."
   },
   {
    "inicio": 39.08,
    "fim": 44.87,
